# ==============================================================================
# INFRALYTIX Backend Environment Configuration Template
# Copy this file to `.env` in the backend directory or workspace root.
# ==============================================================================

# System & Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME=INFRALYTIX
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=infralytix-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database
# PostgreSQL Production: postgresql://postgres:postgres@localhost:5432/infralytix
# SQLite Development fallback:
DATABASE_URL=sqlite:///./infralytix.db

# Distributed Caching (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=False
CACHE_TTL_SECONDS=300

# CORS Origins (JSON list or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Automated Intelligence Scheduler (APScheduler)
SCHEDULER_ENABLED=True
RISK_RECALCULATION_INTERVAL_MINUTES=60
HEALTH_RECALCULATION_INTERVAL_MINUTES=60
EARLY_WARNING_SCAN_INTERVAL_MINUTES=30
